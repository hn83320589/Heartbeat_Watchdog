{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning",
      "Microsoft.EntityFrameworkCore": "Warning",
      "System.Net.Http.HttpClient": "Warning"
    }
  },
  "AllowedHosts": "*",
  "ConnectionStrings": {
    "Watchdog": "Data Source=watchdog.db"
  },
  "Watchdog": {
    "ApiKey": "",
    "DefaultWebhookUrl": "",
    "CheckInterval": "00:00:30",
    "DispatchInterval": "00:00:02",
    "WebhookMaxAttempts": 3,
    "WebhookRetryBaseDelay": "00:00:05",
    "WebhookTimeout": "00:00:10"
  }
}
